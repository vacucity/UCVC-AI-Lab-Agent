# Copy to .env and fill in your own values. Never commit .env.

# Any OpenAI-compatible chat endpoint
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-flash

# Postgres with pgvector (Chapters 4-7), matching the docker command in README.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_memory
